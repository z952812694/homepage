{	
	"配置说明":{
		"all_play_time":"总的播放时长，该时长结束，界面关闭（秒为单位）",
		"tween_arr":"运动表",
		"step":"第几步",
		"desc":"本步骤解释（方便查看）",
		"component":"组件名称, 不能重复（自己起即可）", 
		"component_type": "(组件类型，定好后，由代码创建， 1代表是图片控件，2代表是文本控件，目前只有这两种)", 
		"source":"图片控件的资源,在此目录resource/game/storyAnimation/texture", 
		"text":"文本控件的显示文本内容", 
		"init_attr": "初始化属性值，x, y, alpha, width, height, scaleX, scaleY",
		"end_attr": "结束运动的属性值，x, y, alpha, width, height, scaleX, scaleY",
		"tween_list_all_pass_time": "该段运动结束后所经历的总时间（秒）",
		"tween_list":"运动列表，数组形式，每一个{}括起来的是代表1段运动",
		"other":"如{wait:0, tween:y, value:280, value_len: 15, time:0.7}，wait表示该段运动开始时的等待时间， tween:y代表岩y轴运动, value:280代表运动280像素， value_len: 15 代表运动的长度（距初始值）， 有正负的。time表示时间"
	},
